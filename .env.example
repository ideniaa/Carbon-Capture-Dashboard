# Copy this file to .env and fill in your values.
# The .env file is gitignored and stays local only.

SECRET_KEY=change-me-to-a-random-string

MODBUS_HOST=
MODBUS_PORT=502
MODBUS_UNIT_ID=2

SQL_SERVER=YOUR_SERVER\SQLEXPRESS
SQL_DATABASE=YOUR_DATABASE
SQL_USERNAME=your_username
SQL_PASSWORD=your_password
# Or use a full connection string instead of the four above:
# SQL_SERVER_CONNECTION_STRING=DRIVER={SQL Server};SERVER=YOUR_SERVER\SQLEXPRESS;DATABASE=YOUR_DATABASE;UID=your_username;PWD=your_password;

SQL_TRUSTED_CONNECTION=
SQL_VOLTAGE_TABLE=Voltage
SQL_VOLTAGE_TABLE_PATTERN=V%
SQL_VOLTAGE_ROW_ID_COLUMN=row_num
SQL_VOLTAGE_TIMESTAMP_COLUMN=date_time

TITROLYZER_APP_PATH=C:\Titrolyzer\Titrolyzer.py
TITROLYZER_PYTHON_EXE=

WINDAQ_MSSQL_EXE=C:\WINDAQMSSQL\WINDAQMSSQL.exe
WINDAQ_MSSQL_PROCESS_NAME=
WINDAQ_MSSQL_PID_FILE=
WINDAQ_MSSQL_AUTO_START=1
